# Public base URL (used for metadata, sitemap and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe: use TEST keys (sk_test_..., whsec_...) until you're ready to launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase (orders, inquiries and private artwork storage).
# Without these, data is written to LOCAL_DATA_DIR for local development only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOADS_BUCKET=customer-uploads
LOCAL_DATA_DIR=.data

# Transactional email via Resend. Without these, no email is sent (and the app says so).
RESEND_API_KEY=
EMAIL_FROM="TAPFORM <orders@yourdomain.com>"
SALES_INBOX=
