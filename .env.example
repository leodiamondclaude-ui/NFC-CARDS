# ---------------------------------------------------------------------------
# TAPCARD environment variables. Copy to .env.local and fill in what you need.
# Everything is optional for local development: without keys the app uses a
# local JSON store in .data/ and a development checkout that takes no payment.
# Never commit real values. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------------------

# Public base URL (metadata, sitemap, canonical URLs, Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (server only) ---------------------------------------------------
# Use TEST keys (sk_test_..., whsec_...) until launch. Without a secret key,
# checkout runs in development mode locally and is disabled in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Supabase (server only) -------------------------------------------------
# The service-role key bypasses RLS: keep it on the server, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOADS_BUCKET=customer-uploads
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images
# Local fallback store used when Supabase isn't configured (development only)
LOCAL_DATA_DIR=.data

# --- Admin dashboard (server only) ------------------------------------------
# There is no default login. Run `npm run admin:hash` to create these values.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Random string of at least 32 characters; changing it signs everyone out.
ADMIN_SESSION_SECRET=

# --- Email via Resend (server only) -----------------------------------------
# Without these, emails are not sent and the app reports that honestly.
RESEND_API_KEY=
EMAIL_FROM="TAPCARD <orders@yourdomain.com>"
# Where quote requests and contact messages are forwarded
SALES_INBOX=

# --- Analytics (public, optional) -------------------------------------------
# Scripts load only when an ID is set AND the visitor accepts the cookie banner.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Development -------------------------------------------------------------
# Set to 1 to allow the no-payment development checkout under `next start`
# on your own machine. Ignored on Vercel production deployments. Never set it
# on a live store.
TAPCARD_DEV_MODE=
